# Copy to .env and fill in for your environment. Never commit the real .env.
DATA_RAW_DIR=/app/data/raw
DATA_PROCESSED_DIR=/app/data/processed
MODELS_DIR=/app/models

# Optional HTTP(S) prefix that serves classifier.joblib + feature_columns.json.
# Used by `python -m src.models.sync --pull/--push`. Leave unset for a local
# bind mount or the Kubernetes models PVC.
# MODEL_STORAGE_BASE_URL=
# MODEL_STORAGE_TOKEN=
